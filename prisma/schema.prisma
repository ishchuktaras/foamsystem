generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// Výčet všech povolených rolí ve firmě
enum Role {
  ADMIN
  JEDNATEL
  SUPERVIZOR
  TECHNIK
  APLIKATOR
  POMOCNIK
}

// Číselník materiálů (Zde budou předvyplněny Ekoprodur systémy)
model Material {
  id                String   @id @default(uuid())
  name              String   
  type              String   
  density           Float    
  yieldPerSetM3     Float    
  wasteFactor       Float    
  buyPricePerSet    Float?   
  
  // Nové technické parametry z certifikátu / TDS (např. pro ICYIZOL)
  lambda            String?  // Součinitel tepelné vodivosti (např. "0,038 W/mK")
  diffusionFactor   String?  // Faktor difúzního odporu (např. "3,3")
  fireReaction      String?  // Reakce na oheň (např. "E")
  svtCode           String?  // SVT kód pro NZÚ (např. "9716")

  // Nové pole pro bezpečné mazání (Soft Delete)
  isArchived        Boolean  @default(false)
  archivedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders            Order[]
}

// Zakázky a výpočty
model Order {
  id                String   @id @default(uuid())
  customerName      String
  address           String?  // Pro výpočet dopravy

  // Vstupní parametry od technika
  areaSqm           Float    // Zadaná plocha v m2
  thicknessM        Float    // Zadaná tloušťka v metrech (např. 0.25)
  
  // Vypočtené hodnoty na pozadí (podle Sergejova vzorce)
  pureVolumeM3      Float    // Čistý objem = areaSqm * thicknessM
  totalVolumeM3     Float    // Celkový objem = pureVolumeM3 * wasteFactor
  requiredSets      Float    // Potřebný počet sad = totalVolumeM3 / yieldPerSetM3

  // Vazba na materiál
  materialId        String
  material          Material @relation(fields: [materialId], references: [id])
  
  // Finance
  calculatedMargin  Float?   // Vypočtený zisk (Cena pro klienta - Náklady na materiál a provoz)
  status            String   @default("DRAFT") // DRAFT, SENT, REALIZED, INVOICED

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Přidáno pro klasické přihlašování jménem a heslem
  role          Role      @default(APLIKATOR) // Přepnuto na bezpečný ENUM typ
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Nastavení firmy (Fakturační údaje pro generování nabídek)
model CompanyProfile {
  id          String   @id @default("default")
  companyName String?
  ico         String?
  dic         String?
  street      String?
  city        String?
  zip         String?
  bankAccount String?
  phone       String?
  email       String?
  website     String?

  updatedAt   DateTime @updatedAt
}



model Quote {
  id           String   @id @default(cuid())
  customerName String
  ico          String?
  street       String?
  city         String
  zip          String?
  materialName String
  area         String
  thickness    String
  totalCost    String
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}